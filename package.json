{
  "name": "portal-fbso",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "tsc -b && react-router build",
